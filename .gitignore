# MediaPipe model: the root copy is tracked so the app runs offline; downloaded
# copies inside the data directory are not.
*.task
!/hand_landmarker.task

# Patient data, database and generated artifacts (LGPD: never commit)
data/
Spectra/
# Keep the source package visible on case-insensitive Windows filesystems.
!/spectra/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
reports/
!/spectra/reports/
exports/
backups/
pintura_*.png
physio_session_*.csv
*.pdf
secrets/
*.key
.env
.env.*
